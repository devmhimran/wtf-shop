generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  engineType = "client"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum ShippingRegion {
  INSIDE_AU
  OUTSIDE_AU
}

enum ProductType {
  STANDARD
  CUSTOM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
  RETURNED
}

enum DeliveryMethod {
  PICKUP
  SHIPPING
}

enum PaymentStatus {
  INCOMPLETE
  PENDING
  PAID
  FAILED
  REFUNDED
}

//
// USER MODEL
//
model User {
  id              Int       @id @default(autoincrement())
  userId          String?   @unique
  name            String?
  email           String   @unique
  password        String?
  role            UserRole @default(CUSTOMER)
  isDelete        Boolean  @default(false)
  isActive        Boolean  @default(true)

  orders          Order[]
  createdProducts Product[] @relation("ProductCreatedBy")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  refreshToken     String?
  refreshTokenUpdatedAt DateTime?

  mediaLibrary MediaLibrary[] @relation("MediaUploadedBy")
}

//
// CATEGORY
//
model Category {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String   @unique

  imageId         Int?
  image           MediaLibrary? @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  subcategories   SubCategory[]
  products        Product[]
}

//
// SUB CATEGORY
//
model SubCategory {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String   @unique

  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId   Int?

  products     Product[]
}

//
// COLOR
//
model Color {
  id        Int       @id @default(autoincrement())
  name      String     @unique
  hex       String?
  variants  ProductVariant[]
}

//
// SIZE
//
model Size {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  variants ProductVariant[]
}

//
// MEDIA LIBRARY (NEW MODEL)
//
model MediaLibrary {
  id         Int      @id @default(autoincrement())
  title      String?
  alt        String?
  fileUrl    String            
  fileName   String   @unique  
  fileType   String?
  fileSize   Int?

  // optional uploader
  createdBy   User?    @relation("MediaUploadedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?

  // relations with product and gallery
  mainImageProducts    Product[]       @relation("MainImage")
  alternativeImageProducts Product[]   @relation("AlternativeImage")
  galleryItems         ProductGallery[]
  categories           Category[]      @relation("CategoryImage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// PRODUCT MODEL
//
model Product {
  id                Int       @id @default(autoincrement())
  catalogId         String?
  title             String
  shortDescription  String?
  description       String?
  additionalDesc    String?
  discountNote    String?

  metaTitle         String?
  metaDescription   String?
  metaKeyword       String?
  productType       ProductType?

  twoSidePrice      Float?

  isNew             Boolean  @default(false)
  isActive          Boolean  @default(true)
  isDelete          Boolean  @default(false)
  slug              String   @unique
  flatDiscount      Float?   @default(0.0)

  // Updated: images now reference MediaLibrary instead of raw string
  mainImageId        Int?
  mainImage          MediaLibrary? @relation("MainImage", fields: [mainImageId], references: [id], onDelete: SetNull)

  alternativeImageId Int?
  alternativeImage   MediaLibrary? @relation("AlternativeImage", fields: [alternativeImageId], references: [id], onDelete: SetNull)

  gallery            ProductGallery[]
  variants           ProductVariant[]
  quantityDiscounts  QuantityDiscount[]
  orderItems         OrderItem[]

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId   Int?

  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  subCategoryId   Int?

  createdBy     User?      @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById   Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

//
// PRODUCT GALLERY
//
model ProductGallery {
  id         Int       @id @default(autoincrement())

  mediaId    Int?
  media      MediaLibrary? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  Int?
}

//
// PRODUCT VARIANT (UNIQUE COLOR + SIZE)
//
model ProductVariant {
  id        Int   @id @default(autoincrement())

  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId Int?

  color     Color?    @relation(fields: [colorId], references: [id], onDelete: SetNull)
  colorId   Int?

  size      Size?     @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  sizeId    Int?

  price     Float
  quantity  Int      @default(0)

  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId])
}

//
// QUANTITY DISCOUNT
//
model QuantityDiscount {
  id        Int       @id @default(autoincrement())
  minQty    Int
  maxQty    Int
  amount    Float
  note      String?

  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId Int?
}

//
// SHIPPING CHARGE
//
model ShippingCharge {
  id              Int       @id @default(autoincrement())

  region          ShippingRegion @default(INSIDE_AU)

  minQty          Int
  maxQty          Int?

  baseCharge      Float
  additionalChargePerItem Float?
  freeShipping    Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//
// PROMO CODE
//
model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String   @unique
  title       String
  amount      Float
  startDate   DateTime
  endDate     DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//
// ORDER
//
model Order {
  id              Int       @id @default(autoincrement())

  // Customer info
  email           String
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId          Int?

  // Order status
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(INCOMPLETE)
  deliveryMethod  DeliveryMethod @default(SHIPPING)

  // Payment
  stripeId        String?

  // Pricing
  subTotal        Float
  shippingCost    Float     @default(0.0)
  total           Float

  // Shipping address
  address         String?
  state           String?
  postalCode      String?
  country         String?
  phone           String?

  // Relations
  items           OrderItem[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

//
// ORDER ITEM
//
model OrderItem {
  id         Int       @id @default(autoincrement())

  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    Int?

  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  Int?

  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId  Int?

  // Item details
  color      String?
  size       String?
  printSide  String?
  
  quantity   Int
  price      Float
  total      Float

  // Customization (moved from Order)
  customImages CustomOrderImage[]
  customNote   String?
}

//
// CUSTOM ORDER IMAGE
//
model CustomOrderImage {
  id           Int       @id @default(autoincrement())

  orderItem    OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  orderItemId  Int?

  imageUrl     String
  imageName    String?
  note         String?
}
