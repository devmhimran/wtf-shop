
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
   engineType = "client"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum ShippingRegion {
  INSIDE_AU
  OUTSIDE_AU
}

// USER MODEL
model User {
  id              Int       @id @default(autoincrement())
  userId          String?   @unique 
  name      String?
  email     String   @unique
  password  String?
  role      UserRole @default(CUSTOMER)
  isDelete  Boolean  @default(false)
  isActive Boolean  @default(true)

  orders          Order[]
  createdProducts Product[] @relation("ProductCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshToken     String?
  refreshTokenUpdatedAt DateTime?
}

// PRODUCT CATEGORY
model Category {
  id              Int       @id @default(autoincrement())
  name      String
  slug      String        @unique

  subcategories SubCategory[]
  products      Product[]
}

// SUB CATEGORY
model SubCategory {
  id              Int       @id @default(autoincrement())
  name      String
  slug      String        @unique

  category     Category   @relation(fields: [categoryId], references: [id])
  categoryId   Int

  products     Product[]
}

// COLOR MODEL
model Color {
  id              Int       @id @default(autoincrement())
  name     String           @unique
  hex      String?
  variants ProductVariant[]
}

// SIZE MODEL
model Size {
  id              Int       @id @default(autoincrement())
  name     String           @unique
  variants ProductVariant[]
}

// PRODUCT MODEL
model Product {
  id              Int       @id @default(autoincrement())
  catalogId          String?
  title              String
  shortDescription   String?
  description        String?
  additionalDesc     String?

  metaTitle          String?
  metaDescription    String?
  metaKeyword        String?

  twoSidePrice       Float?           

  isNew              Boolean           @default(false)
  isActive           Boolean           @default(true)
  isDelete           Boolean           @default(false)
  slug             String           @unique 

  mainImage          String?
  alternativeImage   String?

  gallery            ProductGallery[]
  variants           ProductVariant[]
  quantityDiscounts  QuantityDiscount[]
  orderItems         OrderItem[]

  category     Category     @relation(fields: [categoryId], references: [id])
  categoryId   Int

  subCategory     SubCategory? @relation(fields: [subCategoryId], references: [id])
  subCategoryId   Int?

  createdBy     User      @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdById   Int

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// PRODUCT IMAGE GALLERY
model ProductGallery {
  id              Int       @id @default(autoincrement())
  imageUrl  String

  product   Product  @relation(fields: [productId], references: [id])
  productId Int
}

// VARIABLE PRICE MODEL (UNIQUE COLOR + SIZE + PRODUCT)
model ProductVariant {
  id        Int       @id @default(autoincrement())

  product   Product  @relation(fields: [productId], references: [id])
  productId Int

  color     Color    @relation(fields: [colorId], references: [id])
  colorId   Int

  size      Size     @relation(fields: [sizeId], references: [id])
  sizeId    Int

  price     Float    

  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId])
}

// QUANTITY BASED DISCOUNT
model QuantityDiscount {
  id              Int       @id @default(autoincrement())
  minQty     Int
  maxQty     Int
  amount     Float
  note       String?

  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
}

// SHIPPING CHARGE MODEL
model ShippingCharge {
  id              Int       @id @default(autoincrement())

  region        ShippingRegion @default(INSIDE_AU)

  minQty        Int
  maxQty        Int?

  baseCharge    Float
  additionalChargePerItem Float?
  freeShipping  Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// PROMO CODE MODEL
model PromoCode {
  id              Int       @id @default(autoincrement())
  code        String   @unique
  title       String
  amount      Float
  startDate   DateTime
  endDate     DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ORDER
model Order {
  id              Int       @id @default(autoincrement())

  user         User      @relation(fields: [userId], references: [id])
  userId       Int

  items        OrderItem[]
  customImages CustomOrderImage[]
  customNote   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ORDER ITEM
model OrderItem {
  id              Int       @id @default(autoincrement())

  order     Order    @relation(fields: [orderId], references: [id])
  orderId   Int

  product   Product  @relation(fields: [productId], references: [id])
  productId Int

  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId Int?

  quantity  Int
  price     Float
  total     Float
}

// CUSTOM DESIGN IMAGES FOR CUSTOM ORDER
model CustomOrderImage {
  id              Int       @id @default(autoincrement())

  order    Order    @relation(fields: [orderId], references: [id])
  orderId  Int

  imageUrl String
}
